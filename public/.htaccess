<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # 🌐 అడ్మిన్ గారు! VPS (LiteSpeed/Apache) లో అన్ని రూట్స్ సరిగ్గా పనిచేయడానికి ఈ రీరైట్ రూల్స్ అవసరం.
  
  # 🛡️ Force Browser to check for fresh index.html (Zero Caching for index)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule . /index.html [L]
</IfModule>

# 🚀 LiteSpeed Optimization & No-Cache for SPA Entry
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<FilesMatch "index\.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </IfModule>
</FilesMatch>
