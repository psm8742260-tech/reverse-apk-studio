      "type": "html",
      "content": "<!DOCTYPE html>\n<html lang=\"te\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\n<title>Bluetooth Live Dialer</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n  body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background: #030f1e; color: #e2e8f0; -webkit-tap-highlight-color: transparent; }\n  .glow-text { text-shadow: 0 0 16px rgba(56, 189, 248, 0.7), 0 0 32px rgba(14, 165, 233, 0.4); }\n  .glow-box { box-shadow: 0 0 25px rgba(14, 165, 233, 0.15), inset 0 0 15px rgba(56, 189, 248, 0.05); }\n  .dial-btn { transition: all 0.1s ease; }\n  .dial-btn:active { transform: scale(0.92); background: rgba(56, 189, 248, 0.25); }\n  .pulse-live { animation: pulseLive 1.8s infinite; }\n  @keyframes pulseLive { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.9); } }\n</style>\n</head>\n<body class=\"min-h-screen flex flex-col justify-between p-3.5 sm:p-5 select-none\">\n\n  <!-- Top Header Bar -->\n  <header class=\"w-full max-w-md mx-auto flex items-center justify-between py-2 border-b border-sky-900/40 pb-3\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-11 h-11 rounded-2xl bg-gradient-to-br from-sky-500 to-blue-700 flex items-center justify-center text-white shadow-lg shadow-sky-500/30 text-xl font-black\">\n        ᛒ\n      </div>\n      <div>\n        <h1 class=\"text-lg font-black tracking-tight text-white flex items-center gap-1.5\">\n          Bluetooth Live Dialer\n        </h1>\n        <div class=\"flex items-center gap-1.5 text-[11px] font-bold text-sky-400\">\n          <span class=\"w-2 h-2 rounded-full bg-emerald-400 pulse-live inline-block\"></span>\n          <span>LIVE • సిగ్నల్ యాక్టివ్</span>\n        </div>\n      </div>\n    </div>\n    <button id=\"btToggleBtn\" class=\"px-3.5 py-1.5 rounded-xl bg-sky-950 border border-sky-500/40 text-sky-300 font-mono text-xs font-black tracking-wider hover:bg-sky-900/50 transition active:scale-95 shadow-xs\">\n      BT ON\n    </button>\n  </header>\n\n  <!-- Active Connection Banner -->\n  <section class=\"w-full max-w-md mx-auto my-3\">\n    <div class=\"bg-gradient-to-r from-sky-950/80 via-blue-950/60 to-slate-950/90 border border-sky-500/30 rounded-2xl p-3 flex items-center justify-between glow-box\">\n      <div class=\"flex items-center gap-2.5\">\n        <span class=\"text-emerald-400 text-lg\">📶</span>\n        <div>\n          <p class=\"text-xs font-black text-emerald-300\">బ్లూటూత్ కనెక్ట్ అయింది</p>\n          <p id=\"connectedDeviceName\" class=\"text-[10px] text-sky-300/80 font-mono truncate max-w-[170px]\">Car Audio BT (కనెక్టెడ్)</p>\n        </div>\n      </div>\n      <span class=\"px-2 py-0.5 rounded-md bg-sky-900/40 border border-sky-700/40 text-[10px] font-mono text-sky-300 font-bold\">\n        3 పరికరాలు\n      </span>\n    </div>\n  </section>\n\n  <!-- Number Display Panel -->\n  <section class=\"w-full max-w-md mx-auto my-1 flex-1 flex flex-col justify-center\">\n    <div class=\"bg-slate-950/90 border border-sky-900/60 rounded-3xl p-4 sm:p-5 glow-box relative overflow-hidden\">\n      <div class=\"flex items-center justify-between text-[11px] font-semibold text-slate-400 mb-2\">\n        <span>నంబర్ టైప్ చేయండి</span>\n        <div class=\"flex items-center gap-1.5\">\n          <span id=\"btStatusBadge\" class=\"px-2 py-0.5 rounded bg-sky-950 border border-sky-700/50 text-[10px] font-mono text-sky-300\">BT: Audio</span>\n          <span class=\"px-2 py-0.5 rounded bg-emerald-950 border border-emerald-700/50 text-[10px] font-mono text-emerald-300 font-bold flex items-center gap-1\">\n            <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span> LIVE\n          </span>\n        </div>\n      </div>\n\n      <!-- Main Dialing Screen -->\n      <div class=\"min-h-[72px] flex items-center justify-center text-center px-2 py-2\">\n        <p id=\"numberDisplay\" class=\"text-2xl sm:text-3xl font-black tracking-widest text-sky-400 glow-text break-all\">\n          నంబర్ నమోదు చేయండి...\n        </p>\n      </div>\n\n      <!-- Devices Quick Switch Bar -->\n      <div class=\"mt-3 pt-3 border-t border-sky-900/40\">\n        <div class=\"flex items-center justify-between text-[10px] font-bold text-slate-400 mb-2\">\n          <span class=\"flex items-center gap-1 text-sky-300\">📶 లైవ్ బ్లూటూత్ పరికరాలు</span>\n          <button id=\"rescanBtn\" class=\"text-sky-400 hover:text-sky-300 transition cursor-pointer font-semibold\">రీస్కాన్ ↻</button>\n        </div>\n        <div class=\"grid grid-cols-2 gap-2 text-xs\">\n          <button class=\"device-btn active-device p-2 rounded-xl bg-sky-900/40 border border-sky-400/50 text-white font-bold flex items-center gap-2 transition hover:bg-sky-800/40 text-left\">\n            <span class=\"text-base\">🚗</span>\n            <span class=\"truncate text-[11px]\">Car Audio BT</span>\n          </button>\n          <button class=\"device-btn p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-300 font-bold flex items-center gap-2 transition hover:bg-sky-950/60 hover:border-sky-700/40 text-left\">\n            <span class=\"text-base\">🎧</span>\n            <span class=\"truncate text-[11px]\">Galaxy Buds Pro</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Keypad Section -->\n  <section class=\"w-full max-w-md mx-auto my-2\">\n    <div class=\"grid grid-cols-3 gap-2.5 sm:gap-3\">\n      <button data-key=\"1\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>1</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">—</span>\n      </button>\n      <button data-key=\"2\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>2</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">ABC</span>\n      </button>\n      <button data-key=\"3\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>3</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">DEF</span>\n      </button>\n\n      <button data-key=\"4\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>4</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">GHI</span>\n      </button>\n      <button data-key=\"5\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>5</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">JKL</span>\n      </button>\n      <button data-key=\"6\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>6</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">MNO</span>\n      </button>\n\n      <button data-key=\"7\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>7</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">PQRS</span>\n      </button>\n      <button data-key=\"8\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>8</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">TUV</span>\n      </button>\n      <button data-key=\"9\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>9</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">WXYZ</span>\n      </button>\n\n      <button data-key=\"*\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-sky-400 hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex items-center justify-center\">\n        *\n      </button>\n      <button data-key=\"0\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-white hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex flex-col items-center justify-center\">\n        <span>0</span>\n        <span class=\"text-[9px] text-slate-500 font-semibold tracking-tighter\">+</span>\n      </button>\n      <button data-key=\"#\" class=\"dial-btn py-3 sm:py-3.5 bg-slate-900/90 border border-sky-950 rounded-2xl text-xl sm:text-2xl font-black text-sky-400 hover:border-sky-500/40 hover:bg-sky-950/40 shadow-xs flex items-center justify-center\">\n        #\n      </button>\n    </div>\n\n    <!-- Bottom Dial Controls -->\n    <div class=\"grid grid-cols-3 gap-2.5 mt-3\">\n      <button id=\"backspaceBtn\" class=\"py-3 rounded-2xl bg-amber-950/60 border border-amber-800/40 text-amber-300 font-bold text-sm hover:bg-amber-900/50 transition active:scale-95 flex items-center justify-center\">\n        ⌫\n      </button>\n      <button id=\"callBtn\" class=\"py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-500 text-white font-black text-base shadow-lg shadow-emerald-600/30 hover:brightness-110 transition active:scale-95 flex items-center justify-center gap-1.5\">\n        <span>📞</span> కాల్\n      </button>\n      <button id=\"clearBtn\" class=\"py-3 rounded-2xl bg-rose-950/60 border border-rose-800/40 text-rose-300 font-bold text-xs hover:bg-rose-900/50 transition active:scale-95 flex items-center justify-center\">\n        ✕ క్లియర్\n      </button>\n    </div>\n  </section>\n\n  <!-- Live Call Simulation Toast -->\n  <div id=\"callToast\" class=\"fixed bottom-6 left-1/2 -translate-x-1/2 bg-sky-950/95 border border-sky-400 text-white px-5 py-3 rounded-2xl shadow-2xl opacity-0 pointer-events-none transition-all duration-300 z-50 text-xs font-bold flex items-center gap-2.5\">\n    <span class=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping\"></span>\n    <span id=\"callToastMsg\">బ్లూటూత్ ద్వారా కనెక్ట్ అవుతోంది...</span>\n  </div>\n\n<script>\n(function() {\n  'use strict';\n  let currentNumber = '';\n  let audioCtx = null;\n  let isBtOn = true;\n\n  function playTone(freq) {\n    try {\n      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n      osc.frequency.value = freq || 600;\n      osc.type = 'sine';\n      gain.gain.value = 0.08;\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.start();\n      osc.stop(audioCtx.currentTime + 0.08);\n    } catch(e) {}\n  }\n\n  const display = document.getElementById('numberDisplay');\n  function updateDisplay() {\n    if (!currentNumber) {\n      display.textContent = 'నంబర్ నమోదు చేయండి...';\n      display.className = 'text-2xl sm:text-3xl font-black tracking-widest text-slate-600 break-all';\n    } else {\n      display.textContent = currentNumber;\n      display.className = 'text-2xl sm:text-3xl font-black tracking-widest text-sky-400 glow-text break-all';\n    }\n  }\n\n  document.querySelectorAll('[data-key]').forEach(btn => {\n    btn.addEventListener('click', () => {\n      const key = btn.getAttribute('data-key');\n      if (currentNumber.length < 15) {\n        currentNumber += key;\n        playTone(450 + (key.charCodeAt(0) * 8));\n        updateDisplay();\n      }\n    });\n  });\n\n  document.getElementById('backspaceBtn').addEventListener('click', () => {\n    if (currentNumber.length > 0) {\n      currentNumber = currentNumber.slice(0, -1);\n      playTone(350);\n      updateDisplay();\n    }\n  });\n\n  document.getElementById('clearBtn').addEventListener('click', () => {\n    currentNumber = '';\n    playTone(250);\n    updateDisplay();\n  });\n\n  const toast = document.getElementById('callToast');\n  const toastMsg = document.getElementById('callToastMsg');\n  function showToast(text, duration = 3000) {\n    toastMsg.textContent = text;\n    toast.classList.remove('opacity-0', 'pointer-events-none');\n    setTimeout(() => {\n      toast.classList.add('opacity-0', 'pointer-events-none');\n    }, duration);\n  }\n\n  document.getElementById('callBtn').addEventListener('click', () => {\n    if (!currentNumber) {\n      showToast('⚠️ దయచేసి డయల్ చేయడానికి నంబర్ ఎంటర్ చేయండి!');\n      return;\n    }\n    showToast('📞 Car Audio BT ద్వారా ' + currentNumber + ' కు కాల్ చేస్తోంది...', 3500);\n    playTone(800);\n  });\n\n  document.getElementById('rescanBtn').addEventListener('click', () => {\n    showToast('🔍 బ్లూటూత్ పరికరాల కోసం స్కాన్ చేస్తోంది...', 2000);\n    playTone(550);\n  });\n\n  document.getElementById('btToggleBtn').addEventListener('click', () => {\n    isBtOn = !isBtOn;\n    const btn = document.getElementById('btToggleBtn');\n    if (isBtOn) {\n      btn.textContent = 'BT ON';\n      btn.className = 'px-3.5 py-1.5 rounded-xl bg-sky-950 border border-sky-500/40 text-sky-300 font-mono text-xs font-black tracking-wider hover:bg-sky-900/50 transition active:scale-95 shadow-xs';\n      showToast('📶 బ్లూటూత్ యాక్టివేట్ చేయబడింది (Active)');\n    } else {\n      btn.textContent = 'BT OFF';\n      btn.className = 'px-3.5 py-1.5 rounded-xl bg-slate-900 border border-slate-700 text-slate-500 font-mono text-xs font-black tracking-wider hover:bg-slate-800 transition active:scale-95 shadow-xs';\n      showToast('🔇 బ్లూటూత్ డిసేబుల్ చేయబడింది (Off)');\n    }\n    playTone(400);\n  });\n\n  document.querySelectorAll('.device-btn').forEach(btn => {\n    btn.addEventListener('click', () => {\n      document.querySelectorAll('.device-btn').forEach(b => {\n        b.className = 'device-btn p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-slate-300 font-bold flex items-center gap-2 transition hover:bg-sky-950/60 text-left';\n      });\n      btn.className = 'device-btn p-2 rounded-xl bg-sky-900/40 border border-sky-400/50 text-white font-bold flex items-center gap-2 transition hover:bg-sky-800/40 text-left';\n      const name = btn.querySelector('span:last-child').textContent;\n      document.getElementById('connectedDeviceName').textContent = name + ' (కనెక్టెడ్)';\n      showToast('🔄 ' + name + ' కు ఆడియో మార్చబడింది!');\n      playTone(700);\n    });\n  });\n})();\n</script>\n</body>\n</html>"
    },
